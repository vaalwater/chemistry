{
  "expo": {
    "name": "理科3D视界",
    "slug": "chem3d-classroom",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/app.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F6FD",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1F6FD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rongweiwei.chem3dclassroom",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "zh-Hans",
          "en"
        ],
        "CFBundleDevelopmentRegion": "zh-Hans",
        "NSPhotoLibraryUsageDescription": "用于访问相册，以便选择或保存与学习相关的图片素材",
        "NSPhotoLibraryAddUsageDescription": "用于将学习相关的图片保存到你的相册"
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.chem3dclassroom"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "用于语音输入：把你说的话转成文字",
          "speechRecognitionPermission": "用于把你说的话转成文字，填入问答输入框"
        }
      ]
    ]
  }
}
