# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# local dev server logs
*.log

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders（整体由 prebuild 生成，不入库）
# 例外：ios/3D/Info.plist 里有手写补丁（UIApplicationSceneManifest、语音权限文案），
# 已用 `git add -f` 单独跟踪 —— 不要把它从版本库里删掉，否则 prebuild 冲掉后无从察觉。
# 它被 /ios 规则排除，所以新增改动要用 `git add -f ios/3D/Info.plist` 才会进暂存区。
/ios
/android

# editor-specific settings
.vscode/

# local scratch/debug artifacts (temp web builds, ad-hoc servers)
tmp_*/
tmp_*.cjs

# browser automation leftovers
.playwright-cli/
setlab.png
s1.yaml

# 一次性素材（隐私页文案草稿与配图，未纳入仓库）
append.png
appendix.md
